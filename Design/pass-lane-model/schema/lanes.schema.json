{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pass-lane-model.lanes.v1",
  "title": "Lane definitions",
  "description": "Lane 是关注对象的类别，也是事件频道。一个 pass 可以向多条 lane 发事件，因此 lane 不是对 pass 的划分。",
  "type": "object",
  "required": ["schemaVersion", "lanes"],
  "properties": {
    "schemaVersion": { "const": "pass-lane-model.lanes.v1" },
    "lanes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "subjectKinds", "visual", "emitters"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "question": { "type": "string", "description": "这条线回答用户的哪一个问题" },
          "subjectKinds": {
            "type": "array",
            "items": { "enum": ["tile", "tensor", "memref", "function", "op", "pipe", "event", "task", "callsite"] },
            "description": "这条线上的 Subject 可以是哪些类型"
          },
          "metrics": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "label", "metricKind"],
              "properties": {
                "id": { "type": "string" },
                "label": { "type": "string" },
                "unit": { "type": "string" },
                "metricKind": {
                  "enum": ["count", "bytes", "ratio", "cardinality", "enum"],
                  "description": "不同 metricKind 不得混成一个“大小”轴；槽位数与定义数是不同口径"
                }
              }
            }
          },
          "visual": {
            "type": "object",
            "required": ["form"],
            "properties": {
              "form": {
                "enum": ["capacity-bars", "layout-map", "lifetime-bands", "attribute-cards", "lineage-tree", "function-tree", "pipe-swimlane", "dag-growth"],
                "description": "渲染形态；与语义解耦，换形态不改数据"
              },
              "primary": { "type": "string", "description": "主视觉编码对应的 metric 或字段" }
            }
          },
          "emitters": {
            "type": "array",
            "items": { "type": "string" },
            "description": "会向这条 lane 发事件的 pass 名；同一 pass 可出现在多条 lane"
          },
          "downstreamEmitters": {
            "type": "array",
            "items": { "type": "string" },
            "description": "PTOAS 等下游仓里延续这条 lane 的 pass；dump 通常取不到，UI 应标为灰段"
          },
          "collapsible": {
            "type": "boolean",
            "description": "true 表示该 lane 在无事件的刻度上应折叠（规范化类 pass 的刻度）"
          }
        }
      }
    }
  }
}
